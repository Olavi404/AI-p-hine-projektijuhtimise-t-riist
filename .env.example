# Anthropic Claude API võti. Hoia seda ainult .env failis (see on .gitignore's).
ANTHROPIC_API_KEY=

# AI pakkuja: "anthropic" (vaikimisi) või "mock" (testimiseks ilma võtmeta, annab etteantud näidisvastused)
AI_PROVIDER=anthropic

# Mudel ja pingutuse tase (low | medium | high)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Serveri port ja andmebaasi fail
PORT=3001
DB_FILE=data/app.db
