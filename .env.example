# Anthropic Claude API võti. Hoia seda ainult .env failis (see on .gitignore's).
ANTHROPIC_API_KEY=

# AI pakkuja:
#   anthropic   – Claude API (vaikimisi, vajab ANTHROPIC_API_KEY ja krediiti)
#   claude-code – kohalik Claude Code'i käsurida (claude -p) sinu Claude Pro/Max tellimusega; API võtit pole vaja
#   mock        – etteantud näidisvastused testimiseks
AI_PROVIDER=anthropic

# Ainult claude-code korral: claude.exe asukoht, kui see pole PATH-is ega ~/.local/bin all
# CLAUDE_BIN=

# Mudel ja pingutuse tase (low | medium | high)
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# API serveri port (Vite arendusserver suunab /api päringud sinna) ja andmebaasi fail
API_PORT=3001
DB_FILE=data/app.db
